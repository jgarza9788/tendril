# Maintainer: Justin Garza <jgarza9788@gmail.com>
pkgname=tendril
pkgver=0.1.0
pkgrel=1
pkgdesc='A Jellyfin music player for the terminal, built with hnoss'
arch=('x86_64')
url='https://github.com/jgarza9788/tendril'
license=('MIT')
depends=('mpv' 'curl')
optdepends=('pipewire-pulse: real audio spectrum in the visualizer (parec, pactl)'
            'playerctl: control Tendril from the command line or media keys')
makedepends=('odin' 'clang' 'git')
source=("$pkgname::git+https://github.com/jgarza9788/tendril.git#tag=v$pkgver"
        "hnoss::git+https://github.com/Huseynteymurzade28/hnoss.git")
# hnoss has no tagged releases: pin the commit you built against by replacing SKIP.
sha256sums=('SKIP' 'SKIP')

prepare() {
  cd "$pkgname"
  rm -rf libs/hnoss
  cp -r "$srcdir/hnoss" libs/hnoss
}

build() {
  cd "$pkgname"
  odin build src -vet -strict-style -warnings-as-errors -o:speed \
    -define:TENDRIL_VERSION="$pkgver" -out:tendril-bin
}

check() {
  cd "$pkgname"
  ./build.sh test
}

package() {
  cd "$pkgname"
  install -Dm755 tendril-bin "$pkgdir/usr/bin/tendril"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
